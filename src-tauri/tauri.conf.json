{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "حسابي",
  "version": "1.0.0",
  "identifier": "com.hesabi.store",
  "build": {
    "beforeDevCommand": "pnpm dev:desktop",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist/public"
  },
  "app": {
    "windows": [{
      "title": "حسابي | إدارة متجرك",
      "width": 1440,
      "height": 900,
      "minWidth": 1024,
      "minHeight": 680,
      "resizable": true,
      "fullscreen": false
    }],
    "security": {
      "freezePrototype": true,
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline' https://fonts.googleapis.com",
        "font-src": "'self' https://fonts.gstatic.com data:",
        "img-src": "'self' data: blob: asset: http://asset.localhost",
        "media-src": "'self' blob:",
        "frame-src": "'self' blob:",
        "connect-src": "'self' ipc: http://ipc.localhost https://*.firebaseio.com https://*.firebaseapp.com https://*.googleapis.com https://*.gstatic.com https://firestore.googleapis.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://fonts.googleapis.com https://fonts.gstatic.com",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'self'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "targets": ["msi", "nsis", "appimage", "deb"],
    "windows": { "webviewInstallMode": { "type": "downloadBootstrapper" } }
  },
  "plugins": { "shell": { "open": true } }
}
